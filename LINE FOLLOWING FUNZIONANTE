#include <Servo.h>
#include<SoftwareSerial.h>

const int ant=1700, orar=1300, fermo=1500;	//definizione sensi di rotazione delle ruote

const int pinSx=12,pinDx=13;											                  //definizione pin dei servomotori

const int pinLed = 8, pinBuzzer = 7;

//variabili di supporto
bool finePista = false;
const int sogliaSensore = 200;                                          //Soglia lettura analogica oltre la quale il valore è considerato 1
char sceltaUtente;
char comando;
bool pista = true;
// pin sensore bluetooth
byte const RXpin=4; 
byte const TXpin=5; 

SoftwareSerial RobotBT(RXpin, TXpin);

//pin sensore HC
const int pinTrig=3;     
const int pinEcho=2;
const int usTocm=29;
long duration;           

//pin sensore IR
const int sensorIR=A5;


//variabili distanze ostacoli
float distanceHC,distanceIR;


//dichiarazione dei servomotori
Servo servoRight;
Servo servoLeft;


//DICHIARAZIONI--------------------------------------------------------------------


void setup() {

  Serial.begin(9600);
  RobotBT.begin(9600); //normalmente lavora a 9600, per configurazione AT si usa 38400
  
  servoRight.attach(pinDx);
  servoLeft.attach(pinSx);
  
  pinMode(pinTrig,OUTPUT);                  
  pinMode(pinEcho,INPUT);
  pinMode(pinLed, OUTPUT);
  pinMode(pinBuzzer, OUTPUT);
  
  RobotBT.println("Connessione OK.");
  // Aspetta che il sensore IR si stabilizzi (gli Sharp sono lenti a caricarsi)
  delay(500); 
  
  stop(3000); // Questo farà i tuoi 3 secondi di pausa
  
}

void loop() {  

  distanceIR = distanceIRmisura();

  if(distanceIR > 15) movimento();

  else{
    stop(1);

    for(int i = 0; i < 16; i++){
      digitalWrite(pinLed, HIGH);
      delay(250);
      digitalWrite(pinLed, LOW);
      delay(250);
    }

    sceltaUtente = chiediUtente();

    if(sceltaUtente == 'A'){
      superaOstacolo();
    }else if(sceltaUtente == 'B'){
      pilota();
    }
  }

}


//FUNZIONI--------------------------------------------------------------------

//funzioni di movimento
void forward(){
  servoRight.writeMicroseconds(orar); 
  servoLeft.writeMicroseconds(ant); 
}
void backward() {
  servoRight.writeMicroseconds(ant); 
  servoLeft.writeMicroseconds(orar); 
}
void turnleft(){
  servoRight.writeMicroseconds(orar); 
  servoLeft.writeMicroseconds(orar);
}
void turnright(){
  servoRight.writeMicroseconds(ant); 
  servoLeft.writeMicroseconds(ant);
}

void left_angoloretto(){
  servoRight.writeMicroseconds(orar); 
  servoLeft.writeMicroseconds(orar);
  delay(350);
}
void right_angoloretto(){
  servoRight.writeMicroseconds(ant); 
  servoLeft.writeMicroseconds(ant);
  delay(350);
}
void stop(int tempoFermo){
  servoRight.writeMicroseconds(fermo); 
  servoLeft.writeMicroseconds(fermo); 
  delay(tempoFermo);

}


//script linefollowing
void movimento(){
  int sx2 = analogRead(A0);
  int sx  = analogRead(A1);
  int ce  = analogRead(A2);
  int dx  = analogRead(A3);
  int dx2 = analogRead(A4);

  if(sx2 > sogliaSensore) sx2 = 1; else sx2 = 0;
  if(sx  > sogliaSensore) sx =  1; else sx  = 0;
  if(dx2 > sogliaSensore) dx2 = 1; else dx2 = 0;
  if(dx  > sogliaSensore) dx =  1; else dx  = 0;
  if(ce  > sogliaSensore) ce =  1; else ce  = 0;

  if((sx==1 && ce==0 && dx==1)|| (sx==0 && ce==0 && dx==0 ) || (sx==1 && ce==1 && dx==1 && dx2==1 && sx2==1)) forward();

  if((sx==1 && ce==0 && dx==0) || (sx==1 && ce==1 && dx==0) || (sx==1 && ce==1 && dx==1 && dx2==0 && sx2==1)) turnright();
  
  if((sx==0 && ce==0 && dx==1) || (sx==0 && ce==1 && dx==1) || (sx==1 && ce==1 && dx==1 && dx2==1 && sx2==0)) turnleft();
  
  if(sx==0 && ce==0 && dx==0 && dx2==0 && sx2==0){
    finePista = true;
    servoRight.detach();
    servoLeft.detach();
    //tone(pinBuzzer, 500, 8000);
    digitalWrite(pinLed, HIGH);
  }
}

//restituisce VERO se il robot si trova sulla pista con i sensori
bool robotSuPista(){
  int sx2 = analogRead(A0);
  int sx  = analogRead(A1);
  int ce  = analogRead(A2);
  int dx  = analogRead(A3);
  int dx2 = analogRead(A4);

  if(sx2 < sogliaSensore) return true;
  if(sx  < sogliaSensore) return true;
  if(dx2 < sogliaSensore) return true;
  if(dx  < sogliaSensore) return true;
  if(ce  < sogliaSensore) return true;

  return false;
}

//pilotaggio robot con BT
void pilota(){
  char comando=' ';
  RobotBT.println("Guida manuale: w, a, s, d.");
  delay(50);
  RobotBT.println("Premi x per uscire.");
  do{
    if (RobotBT.available()) {
      comando = RobotBT.read();
    }
      // ignora invio e spazi
      if (comando == '\r' || comando == '\n' || comando == ' ' || comando == '\t') continue;

      switch (comando) {
      case 'w':
        forward();
        break;

      case 'a':
        turnleft();
        break;

        case 's':
        backward();
        break;

        case 'd':
        turnright();
        break;

        case 'o':
        stop(1);
        break;

      default:
        servoRight.writeMicroseconds(fermo); 
        servoLeft.writeMicroseconds(fermo); 
        break;
      }
  }while(comando != 'x');

}

//misura distanza con IR
float distanceIRmisura() {
  analogRead(sensorIR); // LETTURA A VUOTO: pulisce il convertitore
  delayMicroseconds(100);
  int raw = analogRead(sensorIR);
  float volts = raw * 0.004887585;

  float distanzaCalcolata = 30.0 / volts;
 
  return distanzaCalcolata;
}

//distanza con HC
float distanceHCmisura(){
  digitalWrite(pinTrig, LOW);               
  delayMicroseconds(5);                     
  digitalWrite(pinTrig, HIGH);              
  delayMicroseconds(10);                    
  digitalWrite(pinTrig, LOW);              
  duration = pulseIn(pinEcho, HIGH, 25000); 
  float distance=duration/usTocm/2;               
  return distance;
}


//script salta ostacolo
void superaOstacolo() {
  do{
      distanceHC = distanceHCmisura();
      turnleft();
    }while(distanceHC > 15);
    
    stop(500);

    do{
      pista = robotSuPista();
      distanceHC = distanceHCmisura();

      if(!pista){
        if(distanceHC > 12) turnright();
        else if(distanceHC < 6)  turnleft();
        else forward();
      }else{
        bool fineRaddrizzamento = false;
        do{
          int sx2 = analogRead(A0);
          int sx  = analogRead(A1);
          int ce  = analogRead(A2);
          int dx  = analogRead(A3);
          int dx2 = analogRead(A4);

          if(sx2 > sogliaSensore) sx2 = 1; else sx2 = 0;
          if(sx  > sogliaSensore) sx =  1; else sx  = 0;
          if(dx2 > sogliaSensore) dx2 = 1; else dx2 = 0;
          if(dx  > sogliaSensore) dx =  1; else dx  = 0;
          if(ce  > sogliaSensore) ce =  1; else ce  = 0;

          if((sx2==0 && sx==0 && ce==0 && dx==0 && dx2==0) || (sx2==1 && sx==1 && ce==0 && dx==0 && dx2==1) || (sx2==1 && sx==0 && ce==0 && dx==1 && dx2==1) || (sx2==0 && sx==1 && ce==1 && dx==1 && dx2==1)|| (sx2==0 && sx==0 && ce==1 && dx==1 && dx2==1)) {
            turnleft();
          }

          else if((sx2==1 && sx==1 && ce==1 && dx==0 && dx2==0) || (sx2==1 && sx==1 && ce==1 && dx==1 && dx2==0)) {
            forward();
          }
            
          if (sx2==1 && sx==1 && ce==0 && dx==1 && dx2==1) fineRaddrizzamento = true;

        }while(!fineRaddrizzamento);
        stop(50);
      }
    }while(pista == false);
}

//lettura di una riga di testo con Bluetooth

char leggiSceltaAB(unsigned long timeoutMs) {
  unsigned long start = millis();

  while (millis() - start < timeoutMs) {
    if (RobotBT.available()) {
      char c = RobotBT.read();

      // ignora invio e spazi
      if (c == '\r' || c == '\n' || c == ' ' || c == '\t') continue;

      // normalizza in maiuscolo
      if (c >= 'a' && c <= 'z') c = c - ('a' - 'A');

      // accetta solo A o B
      if (c == 'A' || c == 'B') return c;

      // se arriva altro, lo scarto e continuo ad aspettare
    }
  }
  return 0; // 0 = timeout
}


//funzione domanda utente

char chiediUtente() {

  RobotBT.println();
  RobotBT.println("Ostacolo rilevato!");
  delay(50);

  RobotBT.println("Come vuoi superarlo?");
  delay(50);

  RobotBT.println("A = guida autonoma");
  delay(50);

  RobotBT.println("B = pilotare il robot");
  delay(50);

  RobotBT.println("Scrivi A o B e premi INVIO");


  char r = leggiSceltaAB(30000); // 30s tempo di Timeout

  if (r == 0) {
    RobotBT.println("Timeout: nessuna risposta.");
    delay(50);
    RobotBT.println("Superamento autonomo.");
    return 'A';
  }

  RobotBT.print("Hai scelto: ");
  RobotBT.println(r);
  return r;
}
